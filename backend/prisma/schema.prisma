generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                                 String                                  @id @default(cuid())
  name                               String                                  @unique
  subdomain                          String?                                 @unique
  contractPrefix                     String                                  @unique
  isActive                           Boolean                                 @default(true)
  createdAt                          DateTime                                @default(now())
  updatedAt                          DateTime                                @updatedAt
  customDomain                       String?                                 @unique
  emailLogoUrl                       String?
  logoUrl                            String?
  primaryColor                       String?
  secondaryColor                     String?
  signatureUrl                       String?
  legalId                            String?
  legalName                          String?
  representativeAddress              String?
  representativeId                   String?
  representativeMaritalStatus        String?
  representativeName                 String?
  representativePowers               String?
  representativeTitle                String?
  planExpiresAt                      DateTime?
  planType                           String?                                 @default("FREE")
  suspendReason                      String?
  suspendedAt                        DateTime?
  businessAddress                    String?                                 @map("business_address")
  contactEmail                       String?                                 @map("contact_email")
  contactPhone                       String?                                 @map("contact_phone")
  contactWhatsApp                    String?                                 @map("contact_whatsapp")
  emailVerified                      Boolean                                 @default(false)
  emailQuotaDaily                    Int                                     @default(1000) @map("email_quota_daily")
  emailQuotaMonthly                  Int                                     @default(30000) @map("email_quota_monthly")
  emailsSentMonth                    Int                                     @default(0) @map("emails_sent_month")
  emailsSentToday                    Int                                     @default(0) @map("emails_sent_today")
  fromEmail                          String?
  lastEmailResetDate                 DateTime?                               @map("last_email_reset_date")
  preferredCurrency                  String                                  @default("CRC") @map("preferred_currency")
  replyToEmail                       String?
  websiteUrl                         String?                                 @map("website_url")
  billingAuditLogs                   BillingAuditLog[]
  billingClientBalances              BillingClientBalance[]
  billingCreditNotes                 BillingCreditNote[]
  billingInvoices                    BillingInvoice[]
  billingPayments                    BillingPayment[]
  billingReceipts                    BillingReceipt[]
  clients                            Client[]
  clientPortalUsers                  ClientPortalUser[]
  companyBankAccounts                CompanyBankAccount[]
  contracts                          Contract[]
  contractDrafts                     ContractDraft[]
  contractNumbers                    ContractNumber[]
  contractNotes                      ContractNote[]
  customerDocuments                  CustomerDocument[]
  documentSigningSessions            DocumentSigningSession[]
  customerNotes                      CustomerNote[]
  exchangeRates                      ExchangeRate[]
  travelPackages                     TravelPackage[]
  users                              User[]
  attendance_config                  AttendanceConfig?
  attendance_corrections             AttendanceCorrection[]
  attendance_daily_summaries         AttendanceDailySummary[]
  attendance_entries                 AttendanceEntry[]
  employeeDocuments                  EmployeeDocument[]
  employees                          Employee[]
  internalBookings                   InternalTourBooking[]
  internalBookingParticipants        InternalTourBookingParticipant[]
  internalInvoices                   InternalTourInvoice[]
  internalTrips                      InternalTrip[]
  travelPackageParticipants          TravelPackageParticipant[]
  payrollConfig                      PayrollConfig?
  payrollPeriods                     PayrollPeriod[]
  payrollAdjustments                 PayrollAdjustment[]
  payrollRuns                        PayrollRun[]
  additionalServiceOrders            AdditionalServiceOrder[]
  additionalServiceOrderLines        AdditionalServiceOrderLine[]
  additionalServiceOrderParticipants AdditionalServiceOrderParticipant[]
  additionalServiceCatalogItems      AdditionalServiceCatalog[]
  additionalServicePricingConfigs    AdditionalServicePricingConfiguration[]
  suppliers                          Supplier[]

  @@map("tenants")
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  fullName                   String
  passwordHash               String
  isActive                   Boolean                  @default(true)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  activeJti                  String?
  activeAt                   DateTime?
  mustChangePassword         Boolean                  @default(false)
  tenantId                   String?
  role                       UserRole                 @default(AGENT)
  tenant                     Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendance_corrections     AttendanceCorrection[]
  attendance_daily_summaries AttendanceDailySummary[]
  attendance_entries         AttendanceEntry[]
  employee                   Employee?
  passwordResetTokens        PasswordResetToken[]
  assignedCustomers          Client[]                 @relation("CustomerAssignedTo")

  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model ClientPortalUser {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String
  passwordHash String
  isActive     Boolean   @default(true)
  clientId     String
  tenantId     String
  activeJti    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@index([email])
}

model ContractNumber {
  id              String   @id @default(cuid())
  number          String   @unique
  createdByUserId String
  createdByEmail  String
  createdByName   String
  createdAt       DateTime @default(now())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tenantId])
}

model Contract {
  id                    String                   @id @default(cuid())
  contractNumber        String                   @unique
  destination           String
  generatedByUserId     String
  generatedByEmail      String
  generatedByName       String
  issuedAt              DateTime?
  startDate             DateTime?
  endDate               DateTime?
  payload               Json
  pdfObjectKey          String?
  pdfFileName           String?
  pdfMimeType           String?
  pdfSize               Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  clientId              String
  status                String                   @default("PENDING_SIGNATURE")
  signedPdfObjectKey    String?
  signedPdfFileName     String?
  signedPdfMimeType     String?
  signedPdfSize         Int?
  signedByName          String?
  signedAt              DateTime?
  signedClientIp        String?
  signedUserAgent       String?
  cancelledAt           DateTime?
  htmlObjectKey         String?
  signaturePngObjectKey String?
  viewedAt              DateTime?
  paymentReference      String                   @unique
  contractType          String                   @default("CUSTOM")
  travelPackageId       String?
  participantCount      Int                      @default(1)
  source                ContractSource           @default(SCHEDULED_TRIP)
  tenantId              String
  internalTripId        String?
  billingCreditNotes    BillingCreditNote[]
  billingInvoice        BillingInvoice?
  billingPayments       BillingPayment[]
  billingReceipts       BillingReceipt[]
  client                Client                   @relation(fields: [clientId], references: [id])
  internalTrip          InternalTrip?            @relation(fields: [internalTripId], references: [id])
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  travelPackage         TravelPackage?           @relation(fields: [travelPackageId], references: [id])
  documents             ContractDocument[]
  signatureEvents       ContractSignatureEvent[]
  usedTokens            ContractUsedToken[]
  signingSessions       DocumentSigningSession[]
  notes                 ContractNote[]

  @@index([clientId])
  @@index([travelPackageId])
  @@index([internalTripId])
  @@index([contractType])
  @@index([createdAt])
  @@index([tenantId])
}

model ContractDraft {
  id                String         @id @default(cuid())
  contractNumber    String         @unique
  status            String         @default("DRAFT")
  clientFullName    String?
  clientIdNumber    String?
  clientEmail       String?
  clientPhone       String?
  destination       String?
  payload           Json
  generatedByUserId String
  generatedByEmail  String
  generatedByName   String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  source            ContractSource @default(SCHEDULED_TRIP)
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([generatedByUserId])
  @@index([createdAt])
  @@index([tenantId])
}

model Client {
  id                                   String                              @id @default(cuid())
  fullName                             String
  idNumber                             String
  idType                               String?
  email                                String?
  phone                                String?
  emergencyContactName                 String?
  emergencyContactPhone                String?
  createdAt                            DateTime                            @default(now())
  updatedAt                            DateTime                            @updatedAt
  tenantId                             String
  dateOfBirth                          DateTime?
  nationality                          String?
  occupation                           String?
  maritalStatus                        String?
  address                              String?
  city                                 String?
  country                              String?
  postalCode                           String?
  secondaryEmail                       String?
  secondaryPhone                       String?
  emergencyContactRelationship         String?
  emergencyContactEmail                String?
  leadSource                           String?
  customerStatus                       String                              @default("ACTIVE")
  assignedToUserId                     String?
  lastContactDate                      DateTime?
  nextFollowUpDate                     DateTime?
  preferredLanguage                    String?
  tags                                 String?
  bloodType                            String?
  allergies                            String?
  medicalConditions                    String?
  medications                          String?
  billingClientBalance                 BillingClientBalance?
  billingInvoices                      BillingInvoice[]
  tenant                               Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portalUsers                          ClientPortalUser[]
  contracts                            Contract[]
  internalBookings                     InternalTourBooking[]
  internalBookingParticipations        InternalTourBookingParticipant[]
  travelPackageParticipations          TravelPackageParticipant[]
  documents                            CustomerDocument[]
  notes                                CustomerNote[]
  assignedTo                           User?                               @relation("CustomerAssignedTo", fields: [assignedToUserId], references: [id])
  additionalServiceOrderParticipations AdditionalServiceOrderParticipant[]

  @@unique([tenantId, idType, idNumber])
  @@index([fullName])
  @@index([email])
  @@index([tenantId])
  @@index([customerStatus])
  @@index([assignedToUserId])
  @@index([lastContactDate])
  @@index([nextFollowUpDate])
}

model CustomerDocument {
  id               String                   @id @default(cuid())
  customerId       String
  tenantId         String
  category         CustomerDocumentCategory
  originalFileName String
  objectKey        String                   @unique
  mimeType         String
  size             Int
  isCurrent        Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  customer         Client                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
  @@index([category])
  @@index([createdAt])
  @@index([tenantId, customerId])
  @@index([customerId, category, isCurrent])
  @@map("customer_documents")
}

model CustomerNote {
  id              String   @id @default(cuid())
  customerId      String
  tenantId        String
  note            String
  createdByUserId String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Client   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
  @@index([createdAt])
  @@map("customer_notes")
}

model ContractNote {
  id              String    @id @default(cuid())
  contractId      String
  passengerType   String // "HOLDER", "COMPANION", "MINOR"
  passengerIndex  Int? // Index in companions/minors array (null for holder)
  passengerName   String // Full name of passenger for display
  note            String // Note content
  status          String    @default("ACTIVE") // "ACTIVE", "ARCHIVED"
  archivedAt      DateTime?
  createdByUserId String
  createdByName   String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenantId        String
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("contract_notes")
}

model ContractDocument {
  id               String   @id @default(cuid())
  contractId       String
  kind             String?
  originalFileName String
  objectKey        String   @unique
  mimeType         String
  size             Int
  createdAt        DateTime @default(now())
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([createdAt])
}

model ContractSignatureEvent {
  id              String   @id @default(cuid())
  contractId      String
  signerKey       String
  signerRole      String
  signerName      String
  signedAt        DateTime
  signedClientIp  String?
  signedUserAgent String?
  signaturePngKey String?
  signedPdfKey    String?
  signedPdfBytes  Int?
  signedPdfSha256 String?
  tokenHash       String?
  createdAt       DateTime @default(now())
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([signedAt])
}

model ContractUsedToken {
  id         String   @id @default(cuid())
  contractId String
  tokenHash  String   @unique
  signerKey  String
  usedAt     DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model DocumentSigningSession {
  id          String            @id @default(cuid())
  contractId  String
  tenantId    String
  processType String            @default("CONTRACT")
  status      String            @default("PENDING")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents   DocumentSigning[]

  @@index([contractId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, contractId])
  @@map("document_signing_sessions")
}

model DocumentSigning {
  id                    String                 @id @default(cuid())
  sessionId             String
  documentKey           String
  documentType          String
  status                String                 @default("PENDING")
  pdfObjectKey          String?
  pdfFileName           String?
  pdfMimeType           String?
  pdfSize               Int?
  htmlObjectKey         String?
  signedPdfObjectKey    String?
  signedPdfFileName     String?
  signedPdfMimeType     String?
  signedPdfSize         Int?
  signaturePngObjectKey String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  session               DocumentSigningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  signers               DocumentSigner[]

  @@unique([sessionId, documentKey])
  @@index([sessionId])
  @@index([status])
  @@index([documentType])
  @@index([createdAt])
  @@index([sessionId, status])
  @@map("document_signings")
}

model DocumentSigner {
  id                String          @id @default(cuid())
  documentSigningId String
  signerKey         String
  signerRole        String
  signerName        String
  signerEmail       String?
  status            String          @default("PENDING")
  signedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  documentSigning   DocumentSigning @relation(fields: [documentSigningId], references: [id], onDelete: Cascade)

  @@index([documentSigningId])
  @@index([status])
  @@index([signerKey])
  @@index([createdAt])
  @@index([documentSigningId, status])
  @@map("document_signers")
}

model BillingInvoice {
  id              String              @id @default(cuid())
  contractId      String              @unique
  clientId        String
  contractNumber  String              @unique
  invoiceNumber   String              @unique
  currency        String              @default("CRC")
  totalAmount     Decimal             @db.Decimal(14, 2)
  verifiedAmount  Decimal             @db.Decimal(14, 2)
  pendingAmount   Decimal             @db.Decimal(14, 2)
  balanceAmount   Decimal             @db.Decimal(14, 2)
  status          String              @default("FACTURA_EMITIDA")
  issuedAt        DateTime            @default(now())
  closedAt        DateTime?
  createdByUserId String
  createdByName   String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  objectKeyPdf    String?
  pdfFileName     String?
  pdfMimeType     String?
  pdfSize         Int?
  paymentDueDate  DateTime?
  tenantId        String
  creditNotes     BillingCreditNote[]
  client          Client              @relation(fields: [clientId], references: [id])
  contract        Contract            @relation(fields: [contractId], references: [id])
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments        BillingPayment[]
  receipts        BillingReceipt[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

model BillingPayment {
  id                    String                     @id @default(cuid())
  invoiceId             String
  contractId            String?
  type                  String                     @default("OTHER")
  amount                Decimal                    @db.Decimal(14, 2)
  currency              String                     @default("CRC")
  reportedAt            DateTime                   @default(now())
  status                String                     @default("ABONO_REPORTADO")
  bankReference         String?
  payerName             String?
  notes                 String?
  verifiedAt            DateTime?
  verifiedByUserId      String?
  verifiedByName        String?
  rejectionReason       String?
  createdByUserId       String
  createdByName         String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  destinationAccountId  String?
  destinationBank       String?
  originBank            String?
  paymentCode           String?
  receiptDate           DateTime?
  tenantId              String
  internalTourBookingId String?
  contract              Contract?                  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  destinationAccount    CompanyBankAccount?        @relation(fields: [destinationAccountId], references: [id], onDelete: Restrict)
  internalBooking       InternalTourBooking?       @relation(fields: [internalTourBookingId], references: [id], onDelete: Cascade)
  invoice               BillingInvoice             @relation(fields: [invoiceId], references: [id])
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments           BillingPaymentAttachment[]
  receipt               BillingReceipt?
  receiptImage          PaymentReceiptImage?

  @@index([invoiceId])
  @@index([contractId])
  @@index([internalTourBookingId])
  @@index([destinationAccountId])
  @@index([paymentCode])
  @@index([status])
  @@index([reportedAt])
  @@index([tenantId])
}

model BillingPaymentAttachment {
  id               String         @id @default(cuid())
  paymentId        String
  objectKey        String         @unique
  originalFileName String
  mimeType         String
  size             Int
  createdAt        DateTime       @default(now())
  payment          BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
}

model BillingReceipt {
  id               String         @id @default(cuid())
  paymentId        String         @unique
  invoiceId        String
  contractId       String
  contractNumber   String
  receiptNumber    String         @unique
  amount           Decimal        @db.Decimal(14, 2)
  issuedAt         DateTime       @default(now())
  issuedByUserId   String
  issuedByName     String
  approvedAt       DateTime?
  approvedByUserId String?
  approvedByName   String?
  sentAt           DateTime?
  sentToEmail      String?
  objectKeyPdf     String?
  status           String         @default("RECIBO_PENDIENTE_VERIFICACION")
  createdAt        DateTime       @default(now())
  tenantId         String
  contract         Contract       @relation(fields: [contractId], references: [id])
  invoice          BillingInvoice @relation(fields: [invoiceId], references: [id])
  payment          BillingPayment @relation(fields: [paymentId], references: [id])
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([contractId])
  @@index([status])
  @@index([issuedAt])
  @@index([tenantId])
}

model BillingCreditNote {
  id                 String         @id @default(cuid())
  creditNoteNumber   String         @unique
  contractId         String
  invoiceId          String
  contractNumber     String
  reason             String
  amount             Decimal        @db.Decimal(14, 2)
  status             String         @default("NC_EMITIDA")
  sourceDocumentType String
  sourceDocumentId   String
  issuedAt           DateTime       @default(now())
  issuedByUserId     String
  issuedByName       String
  appliedAt          DateTime?
  appliedByUserId    String?
  appliedByName      String?
  objectKeyPdf       String?
  createdAt          DateTime       @default(now())
  tenantId           String
  contract           Contract       @relation(fields: [contractId], references: [id])
  invoice            BillingInvoice @relation(fields: [invoiceId], references: [id])
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([contractId])
  @@index([status])
  @@index([issuedAt])
  @@index([tenantId])
}

model BillingClientBalance {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  availableCreditAmount Decimal  @db.Decimal(14, 2)
  currency              String   @default("CRC")
  updatedAt             DateTime @updatedAt
  tenantId              String
  client                Client   @relation(fields: [clientId], references: [id])
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model BillingAuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  actorUserId String
  actorName   String
  beforeJson  Json?
  afterJson   Json?
  sourceIp    String?
  userAgent   String?
  createdAt   DateTime @default(now())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([tenantId])
}

model ExchangeRate {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  buyRate     Decimal  @db.Decimal(10, 4)
  sellRate    Decimal  @db.Decimal(10, 4)
  source      String   @default("MANUAL")
  setByUserId String
  setByName   String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([date, tenantId])
  @@index([date])
  @@index([setByUserId])
  @@index([tenantId])
}

model CompanyBankAccount {
  id                String           @id @default(cuid())
  bankName          String
  accountNumber     String           @unique
  accountType       String
  currency          String
  sinpeNumber       String?
  accountHolderName String
  isActive          Boolean          @default(true)
  notes             String?
  createdByUserId   String
  createdByName     String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  companyName       String           @default("Empresa")
  tenantId          String
  payments          BillingPayment[]
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([bankName])
  @@index([currency])
  @@index([isActive])
  @@index([companyName])
  @@index([createdAt])
  @@index([tenantId])
}

model PaymentReceiptImage {
  id                          String          @id @default(cuid())
  paymentId                   String?         @unique
  objectKey                   String          @unique
  originalFileName            String
  mimeType                    String
  size                        Int
  extractedData               Json
  extractedAmount             Decimal?        @db.Decimal(14, 2)
  extractedCurrency           String?
  extractedDate               DateTime?
  extractedReference          String?
  extractedOriginBank         String?
  extractedDestinationBank    String?
  extractedDestinationAccount String?
  extractedPayerName          String?
  extractedPaymentCode        String?
  extractedNotes              String?
  confidenceScore             Decimal?        @db.Decimal(5, 4)
  processingStatus            String          @default("PENDING")
  processingError             String?
  processedAt                 DateTime?
  uploadedByUserId            String
  uploadedByName              String
  createdAt                   DateTime        @default(now())
  payment                     BillingPayment? @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([processingStatus])
  @@index([createdAt])
}

model TravelPackage {
  id                      String                     @id @default(cuid())
  name                    String
  destination             String
  departureDate           DateTime
  returnDate              DateTime
  capacity                Int
  occupiedSlots           Int                        @default(0)
  status                  String                     @default("OPEN")
  travelType              TravelPackageType          @default(INTERNATIONAL)
  packagePrice            Decimal?                   @db.Decimal(14, 2)
  priceCurrency           String                     @default("USD")
  createdByUserId         String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  packageCode             String                     @unique
  tenantId                String
