  @@index([fiscalIssuerId, displayOrder])
  @@map("fiscal_issuer_economic_activities")
}

enum BillingOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model BillingOutboxEvent {
  id               String              @id @default(cuid())
  tenantId         String
  eventType        String              @db.VarChar(150)
  eventVersion     Int                 @default(1)
  aggregateType    String              @db.VarChar(100)
  aggregateId      String              @db.VarChar(100)
  correlationId    String?             @db.VarChar(100)
  causationId      String?             @db.VarChar(100)
  deduplicationKey String?             @db.VarChar(200)
  payload          Json
  status           BillingOutboxStatus @default(PENDING)
  availableAt      DateTime            @default(now())
  attemptCount     Int                 @default(0)
  maximumAttempts  Int                 @default(5)
  lockedAt         DateTime?
  lockedBy         String?             @db.VarChar(100)
  processedAt      DateTime?
  lastAttemptAt    DateTime?
  lastError        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deduplicationKey])
  @@index([tenantId, status, availableAt])
  @@index([status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
  @@index([lockedAt])
  @@map("billing_outbox_events")
}

enum AccountReceivableStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

model AccountReceivable {
  id                       String                  @id @default(cuid())
  tenantId                 String
  sourceType               String                  @db.VarChar(100)
  sourceId                 String                  @db.VarChar(100)
  sourceNumber             String?                 @db.VarChar(100)
  sourceDocumentType       String?                 @db.VarChar(50)
  customerId               String?
  debtorDisplayName        String
  debtorIdentificationType String?                 @db.VarChar(4)
  debtorIdentificationNumber String?               @db.VarChar(30)
  currencyCode             String                  @db.VarChar(3)
  originalAmount           Decimal                 @db.Decimal(18, 4)
  outstandingAmount        Decimal                 @db.Decimal(18, 4)
  dueDate                  DateTime                 @db.Date
  paymentTermDays          Int?
  status                   AccountReceivableStatus @default(OPEN)
  recognizedAt             DateTime                 @default(now())
  settledAt                DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, customerId])
  @@index([tenantId, dueDate])
  @@index([tenantId, recognizedAt])
  @@index([tenantId, sourceNumber])
  @@map("account_receivables")
}

enum PaymentStatus {
  RECEIVED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
  CANCELLED
}

model Payment {
  id                            String        @id @default(cuid())
  tenantId                      String
  registrationDeduplicationKey  String        @db.VarChar(200)
  customerId                    String?
  payerDisplayName              String
  payerIdentificationType       String?       @db.VarChar(4)
  payerIdentificationNumber     String?       @db.VarChar(30)
  currencyCode                  String        @db.VarChar(3)
  receivedAmount                Decimal       @db.Decimal(18, 4)
  availableAmount               Decimal       @db.Decimal(18, 4)
  receivedAt                    DateTime
  paymentMethod                 String        @db.VarChar(50)
  externalReference             String?       @db.VarChar(150)
  description                   String?       @db.VarChar(500)
  status                        PaymentStatus @default(RECEIVED)
  cancelledAt                   DateTime?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
  tenant                        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, registrationDeduplicationKey])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, customerId])
  @@index([tenantId, receivedAt])
  @@index([tenantId, externalReference])
  @@map("payments")
}

enum PayrollFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  PAID
  CANCELLED
}

enum PayrollAdjustmentType {
  BONUS
  COMMISSION
  OTHER_EARNING
  EMBARGO
  VOUCHER
  OTHER_DEDUCTION
}

enum PayrollRunStatus {
  CALCULATED
  PAID
  CANCELLED
}

model PayrollConfig {
  id               String           @id @default(cuid())
  tenantId         String           @unique
  frequency        PayrollFrequency @default(BIWEEKLY)
  otMultiplier     Decimal          @default(1.5) @db.Decimal(5, 2)
  employeeCCSSRate Decimal          @db.Decimal(5, 2)
  employerCCSSRate Decimal          @db.Decimal(5, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payroll_config")
}

model PayrollPeriod {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  startDate   DateTime
  endDate     DateTime
  paymentDate DateTime
  status      PayrollPeriodStatus @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adjustments PayrollAdjustment[]
  runs        PayrollRun[]

  @@index([tenantId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("payroll_periods")
}

model PayrollAdjustment {
  id              String                @id @default(cuid())
  tenantId        String
  employeeId      String
  payrollPeriodId String
  type            PayrollAdjustmentType
  amount          Decimal               @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@index([payrollPeriodId])
  @@map("payroll_adjustments")
}

model PayrollRun {
  id              String @id @default(cuid())
  tenantId        String
  employeeId      String
  payrollPeriodId String

  baseSalary Decimal @db.Decimal(12, 2)

  otMinutes Int     @default(0)
  otAmount  Decimal @default(0) @db.Decimal(12, 2)

  attendanceDeductionMinutes Int     @default(0)
  attendanceDeductionAmount  Decimal @default(0) @db.Decimal(12, 2)

  earningsAmount Decimal @default(0) @db.Decimal(12, 2)
  grossAmount    Decimal @default(0) @db.Decimal(12, 2)

  ccssAmount       Decimal @default(0) @db.Decimal(12, 2)
  deductionsAmount Decimal @default(0) @db.Decimal(12, 2)

  netAmount Decimal @default(0) @db.Decimal(12, 2)

  status PayrollRunStatus @default(CALCULATED)

  calculatedAt DateTime?
  paidAt       DateTime?

  approvedByUserId String?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@unique([employeeId, payrollPeriodId])
  @@index([tenantId])
  @@index([employeeId])
  @@index([payrollPeriodId])
  @@index([status])
  @@map("payroll_runs")
}
