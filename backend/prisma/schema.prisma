generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

enum UserRole {
  SUPER_ADMIN // Administrador de la plataforma SaaS (ve todos los tenants)
  ADMIN // Administrador del tenant
  CONTADOR // Contador del tenant
  FACTURACION_COBROS // Facturación y cobros del tenant
  VENTAS // Equipo de ventas del tenant
  OPERACIONES // Operaciones del tenant
  AGENT // Agente de viajes del tenant (default)
}

enum EmployeeStatus {
  ACTIVO
  SUSPENDIDO
  INACTIVO
}

enum EmployeeDocumentType {
  CONTRATO // Contrato laboral
  CEDULA_FRONTAL // Cédula de identidad - lado frontal
  CEDULA_TRASERA // Cédula de identidad - lado trasero
  PASAPORTE // Pasaporte
  LICENCIA // Licencia de conducir
  INCAPACIDAD // Incapacidad médica
  CERTIFICADO // Certificaciones profesionales
  OTRO // Otros documentos
}

enum TransportType {
  AIR      // Avión
  BUS      // Autobús
  PRIVATE  // Vehículo privado
  CRUISE   // Crucero
  WALKING  // A pie
  MIXED    // Combinado
}

// ========================================
// MULTI-TENANT MODEL
// ========================================

model Tenant {
  id             String  @id @default(cuid())
  name           String  @unique // "Viajes Alma Nova", "Lucitours"
  subdomain      String? @unique // "almanova", "lucitours" (futuro)
  customDomain   String? @unique // "system.viajesalmanova.com", "system.lucitour.com"
  contractPrefix String  @unique // "ALM", "LUC" para números de contrato
  isActive       Boolean @default(true)

  // Suspension management (Super Admin)
  suspendedAt   DateTime? // Fecha de suspensión
  suspendReason String? // Razón de suspensión (ej: "Falta de pago")

  // Plan/Subscription (futuro)
  planType      String?   @default("FREE") // FREE, BASIC, PRO, ENTERPRISE
  planExpiresAt DateTime? // Fecha de expiración del plan

  // Branding assets (URLs en DigitalOcean Spaces organizadas por ambiente/tenant)
  logoUrl        String? // Logo principal para PDFs de contratos
  signatureUrl   String? // Firma digital para contratos
  emailLogoUrl   String? // Logo para emails transaccionales
  fromEmail      String? // Email desde el cual se envían emails transaccionales (ej: "noreply@viajesalmanova.com")
  replyToEmail   String? // Email de respuesta para emails transaccionales (ej: "info@viajesalmanova.com")
  emailVerified  Boolean @default(false) // Super Admin marca como verificado en Resend
  
  // Email Rate Limiting (preparado para futuro - sin enforcement en MVP)
  emailQuotaDaily    Int      @default(1000)  @map("email_quota_daily")     // Límite diario de emails
  emailQuotaMonthly  Int      @default(30000) @map("email_quota_monthly")   // Límite mensual de emails
  emailsSentToday    Int      @default(0)     @map("emails_sent_today")     // Contador de emails enviados hoy
  emailsSentMonth    Int      @default(0)     @map("emails_sent_month")     // Contador de emails enviados este mes
  lastEmailResetDate DateTime?                @map("last_email_reset_date") // Última fecha de reset de contadores
  
  primaryColor   String? // Color principal hex (ej: "#4F46E5")
  secondaryColor String? // Color secundario hex

  // Información de contacto (para contratos y comunicaciones)
  contactPhone    String? @map("contact_phone") // Teléfono de contacto (ej: "6015-9906")
  contactWhatsApp String? @map("contact_whatsapp") // Número de WhatsApp (ej: "6015-9906")
  contactEmail    String? @map("contact_email") // Email de contacto para contratos (ej: "contratos@viajesalmanova.com")
  businessAddress String? @map("business_address") // Dirección física de la empresa
  websiteUrl      String? @map("website_url") // Página web de la empresa (ej: "https://viajesalmanova.com")

  // Información legal de la empresa (para contratos)
  legalName                   String? // "VIAJES ALMA NOVA"
  legalId                     String? // "3-101-960028" (cédula jurídica)
  representativeName          String? // "KAREN KEITLYN CAMPOS CANTILLO"
  representativeId            String? // "3-0522-0023"
  representativeTitle         String? // "administradora de agencia de viajes"
  representativeMaritalStatus String? // "soltera"
  representativeAddress       String? // "Cartago"
  representativePowers        String? // "apoderado generalísimo sin límite de suma"

  // Configuración de moneda para viajes internos
  preferredCurrency String @default("CRC") @map("preferred_currency") // Moneda preferida para viajes internos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones con todos los modelos
  users                 User[]
  clients               Client[]
  contracts             Contract[]
  contractDrafts        ContractDraft[]
  contractNumbers       ContractNumber[]
  billingInvoices       BillingInvoice[]
  billingPayments       BillingPayment[]
  billingReceipts       BillingReceipt[]
  billingCreditNotes    BillingCreditNote[]
  billingClientBalances BillingClientBalance[]
  billingAuditLogs      BillingAuditLog[]
  travelPackages        TravelPackage[]
  companyBankAccounts   CompanyBankAccount[]
  exchangeRates         ExchangeRate[]
  clientPortalUsers     ClientPortalUser[] // Usuarios del portal de clientes
  employees             Employee[]
  employeeDocuments     EmployeeDocument[]
  internalTrips         InternalTrip[] // Viajes internos (turismo doméstico)
  internalBookings      InternalTourBooking[] // Reservas de viajes internos
  internalInvoices      InternalTourInvoice[] // Facturas de viajes internos

  @@map("tenants")
}

// ========================================
// USER & AUTH MODELS
// ========================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  fullName           String
  role               UserRole  @default(AGENT)
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  activeJti          String?
  activeAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Multi-tenant
  // Super admins tienen tenantId = NULL, usuarios normales tienen tenantId obligatorio
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  passwordResetTokens PasswordResetToken[]
  employee            Employee? // Relación opcional con empleado

  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_token")
}

// ========================================
// CLIENT PORTAL (FUTURO)
// ========================================

// Usuarios del portal de clientes (clientes finales que ven sus contratos/pagos)
model ClientPortalUser {
  id           String  @id @default(cuid())
  email        String  @unique
  fullName     String
  passwordHash String
  isActive     Boolean @default(true)

  // Cliente que representa (viajero registrado)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Multi-tenant: Cliente pertenece a un tenant específico
  tenantId String @db.Text
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Session management
  activeJti   String?
  lastLoginAt DateTime?

  // Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([clientId])
  @@index([email])
}

model ContractNumber {
  id              String   @id @default(cuid())
  number          String   @unique
  createdByUserId String
  createdByEmail  String
  createdByName   String
  createdAt       DateTime @default(now())

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tenantId])
}

enum ContractSource {
  SCHEDULED_TRIP // [VD] Viaje Disponible (desde paquete programado)
  MIGRATION // [MG] Migrado manualmente (sin viaje asociado)
  CUSTOM_TRIP // [PS] Personalizado (futuro: viaje a medida)
  QUOTE // [CT] Desde cotización (futuro)
  INTERNAL_TRIP // [IT] Viaje interno/doméstico (turismo nacional)
}

model Contract {
  id                    String         @id @default(cuid())
  contractNumber        String         @unique
  paymentReference      String         @unique
  clientId              String
  destination           String
  status                String         @default("PENDING_SIGNATURE")
  generatedByUserId     String
  generatedByEmail      String
  generatedByName       String
  issuedAt              DateTime?
  startDate             DateTime?
  endDate               DateTime?
  payload               Json
  pdfObjectKey          String
  pdfFileName           String
  pdfMimeType           String
  pdfSize               Int
  signedPdfObjectKey    String?
  signedPdfFileName     String?
  signedPdfMimeType     String?
  signedPdfSize         Int?
  signedByName          String?
  signedAt              DateTime?
  signedClientIp        String?
  signedUserAgent       String?
  htmlObjectKey         String?
  viewedAt              DateTime?
  cancelledAt           DateTime?
  signaturePngObjectKey String?
  contractType          String         @default("CUSTOM") // CUSTOM | SCHEDULED
  travelPackageId       String? // FK opcional a TravelPackage (internacional)
  internalTripId        String? // FK opcional a InternalTrip (doméstico)
  participantCount      Int            @default(1) // titular + acompañantes
  source                ContractSource @default(SCHEDULED_TRIP) // Origen del contrato
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  travelPackage      TravelPackage?           @relation(fields: [travelPackageId], references: [id], onDelete: SetNull)
  internalTrip       InternalTrip?            @relation(fields: [internalTripId], references: [id], onDelete: SetNull)
  documents          ContractDocument[]
  signatureEvents    ContractSignatureEvent[]
  usedTokens         ContractUsedToken[]
  billingInvoice     BillingInvoice?
  billingPayments    BillingPayment[]
  billingReceipts    BillingReceipt[]
  billingCreditNotes BillingCreditNote[]

  @@index([clientId])
  @@index([travelPackageId])
  @@index([internalTripId])
  @@index([contractType])
  @@index([createdAt])
  @@index([tenantId])
}

model ContractDraft {
  id                String         @id @default(cuid())
  contractNumber    String         @unique
  status            String         @default("DRAFT")
  clientFullName    String?
  clientIdNumber    String?
  clientEmail       String?
  clientPhone       String?
  destination       String?
  payload           Json
  source            ContractSource @default(SCHEDULED_TRIP) // Origen del contrato
  generatedByUserId String
  generatedByEmail  String
  generatedByName   String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([generatedByUserId])
  @@index([createdAt])
  @@index([tenantId])
}

model Client {
  id                    String   @id @default(cuid())
  fullName              String
  idNumber              String
  email                 String
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contracts            Contract[]
  billingInvoices      BillingInvoice[]
  billingClientBalance BillingClientBalance?
  portalUsers          ClientPortalUser[] // Usuarios del portal para este cliente
  internalBookings     InternalTourBooking[] // Reservas de viajes internos

  @@unique([idNumber, tenantId])
  @@index([fullName])
  @@index([email])
  @@index([tenantId])
}

model ContractDocument {
  id               String   @id @default(cuid())
  contractId       String
  kind             String?
  originalFileName String
  objectKey        String   @unique
  mimeType         String
  size             Int
  createdAt        DateTime @default(now())
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([createdAt])
}

// One row per completed signature event — immutable audit log.
// Captures who signed, when, from where, and the resulting PDF state.
model ContractSignatureEvent {
  id              String   @id @default(cuid())
  contractId      String
  signerKey       String // "client" | "companion-0" etc.
  signerRole      String // "CLIENTE" | "ACOMPANANTE"
  signerName      String
  signedAt        DateTime
  signedClientIp  String?
  signedUserAgent String?
  signaturePngKey String? // Spaces object key of the captured PNG
  signedPdfKey    String? // Spaces object key of the PDF after this signer
  signedPdfBytes  Int?
  signedPdfSha256 String? // hex SHA-256 of the signed PDF at this step
  tokenHash       String? // SHA-256 of the token used (for cross-reference)
  createdAt       DateTime @default(now())
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([signedAt])
}

// One row per spent signing token — tokenHash has a UNIQUE constraint so
// the DB enforces atomicity; two concurrent requests for the same token
// cannot both succeed.
model ContractUsedToken {
  id         String   @id @default(cuid())
  contractId String
  tokenHash  String   @unique // SHA-256 of the raw token string
  signerKey  String
  usedAt     DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model BillingInvoice {
  id              String    @id @default(cuid())
  contractId      String    @unique
  clientId        String
  contractNumber  String    @unique
  invoiceNumber   String    @unique
  currency        String    @default("CRC")
  totalAmount     Decimal   @db.Decimal(14, 2)
  verifiedAmount  Decimal   @db.Decimal(14, 2)
  pendingAmount   Decimal   @db.Decimal(14, 2)
  balanceAmount   Decimal   @db.Decimal(14, 2)
  status          String    @default("FACTURA_EMITIDA")
  issuedAt        DateTime  @default(now())
  paymentDueDate  DateTime?
  closedAt        DateTime?
  objectKeyPdf    String?
  pdfFileName     String?
  pdfMimeType     String?
  pdfSize         Int?
  createdByUserId String
  createdByName   String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contract    Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  payments    BillingPayment[]
  receipts    BillingReceipt[]
  creditNotes BillingCreditNote[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

model BillingPayment {
  id                      String    @id @default(cuid())
  invoiceId               String
  contractId              String?                        // NULL si es turismo interno
  internalTourBookingId   String?                        // NULL si es contrato
  type                    String    @default("OTHER")
  amount                  Decimal   @db.Decimal(14, 2)
  currency                String    @default("CRC")
  reportedAt              DateTime  @default(now())
  status                  String    @default("ABONO_REPORTADO")
  bankReference           String?
  payerName               String?
  notes                   String?
  // Nuevos campos para procesamiento de comprobantes
  originBank              String? // Banco desde donde se hizo el pago
  destinationBank         String? // Banco destino (derivado de la cuenta)
  destinationAccountId    String? // Referencia a CompanyBankAccount
  paymentCode             String? // Código único de pago (LUC-XXXXX)
  receiptDate             DateTime? // Fecha del comprobante (puede diferir de reportedAt)
  verifiedAt              DateTime?
  verifiedByUserId        String?
  verifiedByName          String?
  rejectionReason         String?
  createdByUserId         String
  createdByName           String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoice            BillingInvoice                @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  contract           Contract?                      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  internalBooking    InternalTourBooking?           @relation(fields: [internalTourBookingId], references: [id], onDelete: Cascade)
  destinationAccount CompanyBankAccount?            @relation(fields: [destinationAccountId], references: [id], onDelete: Restrict)
  attachments        BillingPaymentAttachment[]
  receipt            BillingReceipt?
  receiptImage       PaymentReceiptImage?

  @@index([invoiceId])
  @@index([contractId])
  @@index([internalTourBookingId])
  @@index([destinationAccountId])
  @@index([paymentCode])
  @@index([status])
  @@index([reportedAt])
  @@index([tenantId])
}

model BillingPaymentAttachment {
  id               String         @id @default(cuid())
  paymentId        String
  objectKey        String         @unique
  originalFileName String
  mimeType         String
  size             Int
  createdAt        DateTime       @default(now())
  payment          BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
}

model BillingReceipt {
  id               String    @id @default(cuid())
  paymentId        String    @unique
  invoiceId        String
  contractId       String
  contractNumber   String
  receiptNumber    String    @unique
  amount           Decimal   @db.Decimal(14, 2)
  issuedAt         DateTime  @default(now())
  issuedByUserId   String
  issuedByName     String
  approvedAt       DateTime?
  approvedByUserId String?
  approvedByName   String?
  sentAt           DateTime?
  sentToEmail      String?
  objectKeyPdf     String?
  status           String    @default("RECIBO_PENDIENTE_VERIFICACION")
  createdAt        DateTime  @default(now())

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payment  BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice  BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  contract Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([contractId])
  @@index([status])
  @@index([issuedAt])
  @@index([tenantId])
}

model BillingCreditNote {
  id                 String    @id @default(cuid())
  creditNoteNumber   String    @unique
  contractId         String
  invoiceId          String
  contractNumber     String
  reason             String
  amount             Decimal   @db.Decimal(14, 2)
  status             String    @default("NC_EMITIDA")
  sourceDocumentType String
  sourceDocumentId   String
  issuedAt           DateTime  @default(now())
  issuedByUserId     String
  issuedByName       String
  appliedAt          DateTime?
  appliedByUserId    String?
  appliedByName      String?
  objectKeyPdf       String?
  createdAt          DateTime  @default(now())

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoice  BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  contract Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([contractId])
  @@index([status])
  @@index([issuedAt])
  @@index([tenantId])
}

model BillingClientBalance {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  availableCreditAmount Decimal  @db.Decimal(14, 2)
  currency              String   @default("CRC")
  updatedAt             DateTime @updatedAt

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model BillingAuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  actorUserId String
  actorName   String
  beforeJson  Json?
  afterJson   Json?
  sourceIp    String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([tenantId])
}

model ExchangeRate {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  buyRate     Decimal  @db.Decimal(10, 4)
  sellRate    Decimal  @db.Decimal(10, 4)
  source      String   @default("MANUAL")
  setByUserId String
  setByName   String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([date, tenantId])
  @@index([date])
  @@index([setByUserId])
  @@index([tenantId])
}

// Cuentas bancarias de la empresa para recibir pagos
model CompanyBankAccount {
  id                String   @id @default(cuid())
  bankName          String // BAC, BCR, Promerica, etc.
  accountNumber     String   @unique // Número de cuenta o IBAN
  accountType       String // "CUENTA_CORRIENTE", "CUENTA_AHORRO"
  currency          String // "CRC", "USD"
  sinpeNumber       String? // Número SINPE móvil (opcional)
  accountHolderName String // Nombre del titular (Empresa)
  companyName       String   @default("Viajes Alma Nova") // Nombre de la empresa (ej: "Viajes Alma Nova", "Lucitours")
  isActive          Boolean  @default(true)
  notes             String?
  createdByUserId   String
  createdByName     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payments BillingPayment[]

  @@index([bankName])
  @@index([currency])
  @@index([isActive])
  @@index([companyName])
  @@index([createdAt])
  @@index([tenantId])
}

// Imágenes de comprobantes procesados con Vision AI
model PaymentReceiptImage {
  id                          String          @id @default(cuid())
  paymentId                   String?         @unique
  objectKey                   String          @unique // Spaces/S3 key
  originalFileName            String
  mimeType                    String
  size                        Int
  // Datos extraídos por Vision AI
  extractedData               Json // Raw JSON de OpenAI
  extractedAmount             Decimal?        @db.Decimal(14, 2)
  extractedCurrency           String?
  extractedDate               DateTime?
  extractedReference          String?
  extractedOriginBank         String?
  extractedDestinationBank    String?
  extractedDestinationAccount String?
  extractedPayerName          String?
  extractedPaymentCode        String? // Código único de pago
  extractedNotes              String? // Resto del detalle
  confidenceScore             Decimal?        @db.Decimal(5, 4) // 0.0000 - 1.0000
  processingStatus            String          @default("PENDING") // PENDING, PROCESSED, ERROR
  processingError             String?
  processedAt                 DateTime?
  uploadedByUserId            String
  uploadedByName              String
  createdAt                   DateTime        @default(now())
  payment                     BillingPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([processingStatus])
  @@index([createdAt])
}

// Viajes programados — cada viaje es una "plantilla" reutilizable
model TravelPackage {
  id              String   @id @default(cuid())
  packageCode     String   @unique // TP-2026-05-001 (generado automáticamente)
  name            String // "Tour Costa Rica Mayo 2026" (manual)
  destination     String
  departureDate   DateTime
  returnDate      DateTime
  capacity        Int // Cupo máximo
  occupiedSlots   Int      @default(0) // Personas actualmente asignadas
  status          String   @default("OPEN") // OPEN | CLOSED | CANCELLED | COMPLETED
  packagePrice    Decimal? @db.Decimal(14, 2) // Precio del paquete (manual por ahora, futuro: calculado)
  priceCurrency   String   @default("USD") // USD | CRC
  minReservation  Decimal? @db.Decimal(14, 2) // Monto mínimo de reserva (opcional)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contracts Contract[]

  @@index([departureDate])
  @@index([status])
  @@index([createdAt])
  @@index([packageCode])
  @@index([tenantId])
}

// ========================================
// EMPLOYEE & PAYROLL MODELS
// ========================================

// Registro de empleados - Base de datos maestro para RH
model Employee {
  id         String         @id @default(cuid())
  tenantId   String
  // Datos personales
  fullName    String
  documentId  String // Cédula de identidad
  dateOfBirth DateTime? // Fecha de nacimiento (para calcular edad)
  email       String
  phone       String?
  address     String?

  // Datos laborales
  hireDate       DateTime
  position       String // Puesto
  department     String?
  monthlySalary  Decimal        @db.Decimal(12, 2) // Salario mensual base
  dailySalary    Decimal        @db.Decimal(12, 2) // Salario diario = monthlySalary / 30
  status         EmployeeStatus @default(ACTIVO)
  terminationDate DateTime?     // Fecha de terminación (si aplica)

  // Relación con Usuario del sistema (opcional)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relación con Tenant
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Documentos del empleado
  documents EmployeeDocument[]

  // Metadata
  createdByUserId String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, documentId]) // No duplicar cédulas en mismo tenant
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@index([position])
  @@index([department])
  @@index([userId])
  @@map("employees")
}

// Documentos asociados a empleados (contratos, incapacidades, etc.)
model EmployeeDocument {
  id               String               @id @default(cuid())
  employeeId       String
  tenantId         String
  documentType     EmployeeDocumentType
  fileName         String // Nombre original del archivo
  fileUrl          String // URL en Spaces/S3
  objectKey        String               @unique // Key en Spaces/S3
  mimeType         String
  size             Int
  notes            String? // Notas adicionales
  uploadedByUserId String
  uploadedByName   String
  uploadedAt       DateTime             @default(now())

  // Relaciones
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tenantId])
  @@index([documentType])
  @@index([uploadedAt])
  @@map("employee_documents")
}

// ========================================
// INTERNAL TOURISM MODELS (Turismo Doméstico)
// ========================================

model InternalTrip {
  id              String   @id @default(cuid())
  tripCode        String   @unique              // "IT-2026-05"
  name            String                        // "Viaje a Arenal"
  destination     String                        // "La Fortuna, Arenal"
  description     String?
  
  departureDate   DateTime
  returnDate      DateTime
  departureTime   String?                       // "08:00"
  returnTime      String?                       // "18:00"
  
  capacity        Int
  occupiedSlots   Int      @default(0)
  
  price           Decimal  @db.Decimal(12, 2)
  currency        String                        // Moneda del viaje
  minReservation  Decimal? @db.Decimal(12, 2)  // Monto de reserva mínima (opcional)
  
  transportType   TransportType                 // BUS | PRIVATE | WALKING | MIXED
  itinerary       String                        // HTML o texto con actividades
  
  status          String   @default("OPEN")     // OPEN | CLOSED | CANCELLED | COMPLETED
  
  createdByUserId String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Multi-tenant
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Relaciones
  bookings        InternalTourBooking[]
  contracts       Contract[]              // Reservas convertidas a contratos
  
  @@index([departureDate])
  @@index([tenantId])
  @@index([status])
  @@index([tripCode])
  @@map("internal_trips")
}

model InternalTourBooking {
  id              String   @id @default(cuid())
  bookingCode     String   @unique              // "IT-2026-05-001"
  
  // Trip reference
  internalTripId  String
  internalTrip    InternalTrip @relation(fields: [internalTripId], references: [id], onDelete: Restrict)
  
  // Client reference
  clientId        String
  client          Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  
  // Booking details
  participantCount Int
  totalAmount     Decimal   @db.Decimal(12, 2)  // price * participantCount
  currency        String    @default("CRC")
  
  // Payment status
  paidAmount      Decimal   @db.Decimal(12, 2) @default(0)
  pendingAmount   Decimal   @db.Decimal(12, 2) // totalAmount - paidAmount
  status          String    @default("PENDING") // PENDING | PAID | CANCELLED
  
  // Special notes
  notes           String?                       // "Cliente pide ventanilla trasera"
  
  // Audit
  createdByUserId String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Multi-tenant
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Relación con factura y pagos
  invoice         InternalTourInvoice?
  payments        BillingPayment[]             // Reutilizar tabla de pagos
  
  @@index([internalTripId])
  @@index([clientId])
  @@index([tenantId])
  @@index([status])
  @@unique([internalTripId, clientId, tenantId])  // No duplicar reservas
  @@map("internal_tour_bookings")
}

model InternalTourInvoice {
  id              String   @id @default(cuid())
  
  // Reference
  bookingId       String   @unique
  booking         InternalTourBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  // Billing
  invoiceNumber   String   @unique             // "IT-INV-2026-05-001"
  totalAmount     Decimal  @db.Decimal(12, 2)
  paidAmount      Decimal  @db.Decimal(12, 2) @default(0)
  pendingAmount   Decimal  @db.Decimal(12, 2)
  
  // Dates
  issuedAt        DateTime @default(now())
  paymentDueDate  DateTime?
  paidAt          DateTime?
  
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Multi-tenant
  tenantId        String
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([bookingId])
  @@index([tenantId])
  @@index([invoiceNumber])
  @@map("internal_tour_invoices")
}
