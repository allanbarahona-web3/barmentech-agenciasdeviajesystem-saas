generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                          String                       @id @default(cuid())
  name                        String                       @unique
  subdomain                   String?                      @unique
  contractPrefix              String                       @unique
  isActive                    Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  customDomain                String?                      @unique
  emailLogoUrl                String?
  logoUrl                     String?
  primaryColor                String?
  secondaryColor              String?
  signatureUrl                String?
  legalId                     String?
  legalName                   String?
  representativeAddress       String?
  representativeId            String?
  representativeMaritalStatus String?
  representativeName          String?
  representativePowers        String?
  representativeTitle         String?
  planExpiresAt               DateTime?
  planType                    String?                      @default("FREE")
  suspendReason               String?
  suspendedAt                 DateTime?
  businessAddress             String?                      @map("business_address")
  contactEmail                String?                      @map("contact_email")
  contactPhone                String?                      @map("contact_phone")
  contactWhatsApp             String?                      @map("contact_whatsapp")
  emailVerified               Boolean                      @default(false)
  emailQuotaDaily             Int                          @default(1000) @map("email_quota_daily")
  emailQuotaMonthly           Int                          @default(30000) @map("email_quota_monthly")
  emailsSentMonth             Int                          @default(0) @map("emails_sent_month")
  emailsSentToday             Int                          @default(0) @map("emails_sent_today")
  fromEmail                   String?
  lastEmailResetDate          DateTime?                    @map("last_email_reset_date")
  preferredCurrency           String                       @default("CRC") @map("preferred_currency")
  replyToEmail                String?
  websiteUrl                  String?                      @map("website_url")
  billingAuditLogs            BillingAuditLog[]
  billingClientBalances       BillingClientBalance[]
  billingCreditNotes          BillingCreditNote[]
  billingInvoices             BillingInvoice[]
  billingPayments             BillingPayment[]
  billingReceipts             BillingReceipt[]
  clients                     Client[]
  clientPortalUsers           ClientPortalUser[]
  companyBankAccounts         CompanyBankAccount[]
  contracts                   Contract[]
  contractDrafts              ContractDraft[]
  contractNumbers             ContractNumber[]
  exchangeRates               ExchangeRate[]
  travelPackages              TravelPackage[]
  users                       User[]
  attendance_config           AttendanceConfig?
  attendance_corrections      AttendanceCorrection[]
  attendance_daily_summaries  AttendanceDailySummary[]
  attendance_entries          AttendanceEntry[]
  employeeDocuments           EmployeeDocument[]
  employees                   Employee[]
  internalBookings            InternalTourBooking[]
  internalInvoices            InternalTourInvoice[]
  internalTrips               InternalTrip[]

  @@map("tenants")
}

model User {
  id                         String                       @id @default(cuid())
  email                      String                       @unique
  fullName                   String
  passwordHash               String
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  activeJti                  String?
  activeAt                   DateTime?
  mustChangePassword         Boolean                      @default(false)
  tenantId                   String?
  role                       UserRole                     @default(AGENT)
  tenant                     Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendance_corrections     AttendanceCorrection[]
  attendance_daily_summaries AttendanceDailySummary[]
  attendance_entries         AttendanceEntry[]
  employee                   Employee?
  passwordResetTokens        PasswordResetToken[]

  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model ClientPortalUser {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String
  passwordHash String
  isActive     Boolean   @default(true)
  clientId     String
  tenantId     String
  activeJti    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@index([email])
}

model ContractNumber {
  id              String   @id @default(cuid())
  number          String   @unique
  createdByUserId String
  createdByEmail  String
  createdByName   String
  createdAt       DateTime @default(now())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tenantId])
}

model Contract {
  id                    String                   @id @default(cuid())
  contractNumber        String                   @unique
  destination           String
  generatedByUserId     String
  generatedByEmail      String
  generatedByName       String
  issuedAt              DateTime?
  startDate             DateTime?
  endDate               DateTime?
  payload               Json
  pdfObjectKey          String
  pdfFileName           String
  pdfMimeType           String
  pdfSize               Int
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  clientId              String
  status                String                   @default("PENDING_SIGNATURE")
  signedPdfObjectKey    String?
  signedPdfFileName     String?
  signedPdfMimeType     String?
  signedPdfSize         Int?
  signedByName          String?
  signedAt              DateTime?
  signedClientIp        String?
  signedUserAgent       String?
  cancelledAt           DateTime?
  htmlObjectKey         String?
  signaturePngObjectKey String?
  viewedAt              DateTime?
  paymentReference      String                   @unique
  contractType          String                   @default("CUSTOM")
  travelPackageId       String?
  participantCount      Int                      @default(1)
  source                ContractSource           @default(SCHEDULED_TRIP)
  tenantId              String
  internalTripId        String?
  billingCreditNotes    BillingCreditNote[]
  billingInvoice        BillingInvoice?
  billingPayments       BillingPayment[]
  billingReceipts       BillingReceipt[]
  client                Client                   @relation(fields: [clientId], references: [id])
  internalTrip          InternalTrip?            @relation(fields: [internalTripId], references: [id])
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  travelPackage         TravelPackage?           @relation(fields: [travelPackageId], references: [id])
  documents             ContractDocument[]
  signatureEvents       ContractSignatureEvent[]
  usedTokens            ContractUsedToken[]

  @@index([clientId])
  @@index([travelPackageId])
  @@index([internalTripId])
  @@index([contractType])
  @@index([createdAt])
  @@index([tenantId])
}

model ContractDraft {
  id                String         @id @default(cuid())
  contractNumber    String         @unique
  status            String         @default("DRAFT")
  clientFullName    String?
  clientIdNumber    String?
  clientEmail       String?
  clientPhone       String?
  destination       String?
  payload           Json
  generatedByUserId String
  generatedByEmail  String
  generatedByName   String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  source            ContractSource @default(SCHEDULED_TRIP)
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([generatedByUserId])
  @@index([createdAt])
  @@index([tenantId])
}

model Client {
  id                    String                @id @default(cuid())
  fullName              String
  idNumber              String
  email                 String
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tenantId              String
  billingClientBalance  BillingClientBalance?
  billingInvoices       BillingInvoice[]
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portalUsers           ClientPortalUser[]
  contracts             Contract[]
  internalBookings      InternalTourBooking[]

  @@unique([idNumber, tenantId])
  @@index([fullName])
  @@index([email])
  @@index([tenantId])
}

model ContractDocument {
  id               String   @id @default(cuid())
  contractId       String
  kind             String?
  originalFileName String
  objectKey        String   @unique
  mimeType         String
  size             Int
  createdAt        DateTime @default(now())
  contract         Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([createdAt])
}

model ContractSignatureEvent {
  id              String   @id @default(cuid())
  contractId      String
  signerKey       String
  signerRole      String
  signerName      String
  signedAt        DateTime
  signedClientIp  String?
  signedUserAgent String?
  signaturePngKey String?
  signedPdfKey    String?
  signedPdfBytes  Int?
  signedPdfSha256 String?
  tokenHash       String?
  createdAt       DateTime @default(now())
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([signedAt])
}

model ContractUsedToken {
  id         String   @id @default(cuid())
  contractId String
  tokenHash  String   @unique
  signerKey  String
  usedAt     DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model BillingInvoice {
  id              String              @id @default(cuid())
  contractId      String              @unique
  clientId        String
  contractNumber  String              @unique
  invoiceNumber   String              @unique
  currency        String              @default("CRC")
  totalAmount     Decimal             @db.Decimal(14, 2)
  verifiedAmount  Decimal             @db.Decimal(14, 2)
  pendingAmount   Decimal             @db.Decimal(14, 2)
  balanceAmount   Decimal             @db.Decimal(14, 2)
  status          String              @default("FACTURA_EMITIDA")
  issuedAt        DateTime            @default(now())
  closedAt        DateTime?
  createdByUserId String
  createdByName   String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  objectKeyPdf    String?
  pdfFileName     String?
  pdfMimeType     String?
  pdfSize         Int?
  paymentDueDate  DateTime?
  tenantId        String
  creditNotes     BillingCreditNote[]
  client          Client              @relation(fields: [clientId], references: [id])
  contract        Contract            @relation(fields: [contractId], references: [id])
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments        BillingPayment[]
  receipts        BillingReceipt[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

model BillingPayment {
  id                    String                     @id @default(cuid())
  invoiceId             String
  contractId            String?
  type                  String                     @default("OTHER")
  amount                Decimal                    @db.Decimal(14, 2)
  currency              String                     @default("CRC")
  reportedAt            DateTime                   @default(now())
  status                String                     @default("ABONO_REPORTADO")
  bankReference         String?
  payerName             String?
  notes                 String?
  verifiedAt            DateTime?
  verifiedByUserId      String?
  verifiedByName        String?
  rejectionReason       String?
  createdByUserId       String
  createdByName         String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  destinationAccountId  String?
  destinationBank       String?
  originBank            String?
  paymentCode           String?
  receiptDate           DateTime?
  tenantId              String
  internalTourBookingId String?
  contract              Contract?                  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  destinationAccount    CompanyBankAccount?        @relation(fields: [destinationAccountId], references: [id], onDelete: Restrict)
  internalBooking       InternalTourBooking?       @relation(fields: [internalTourBookingId], references: [id], onDelete: Cascade)
  invoice               BillingInvoice             @relation(fields: [invoiceId], references: [id])
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments           BillingPaymentAttachment[]
  receipt               BillingReceipt?
  receiptImage          PaymentReceiptImage?

  @@index([invoiceId])
  @@index([contractId])
  @@index([internalTourBookingId])
  @@index([destinationAccountId])
  @@index([paymentCode])
  @@index([status])
  @@index([reportedAt])
  @@index([tenantId])
}

model BillingPaymentAttachment {
  id               String         @id @default(cuid())
  paymentId        String
  objectKey        String         @unique
  originalFileName String
  mimeType         String
  size             Int
  createdAt        DateTime       @default(now())
  payment          BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([createdAt])
}

model BillingReceipt {
  id               String         @id @default(cuid())
  paymentId        String         @unique
  invoiceId        String
  contractId       String
  contractNumber   String
  receiptNumber    String         @unique
  amount           Decimal        @db.Decimal(14, 2)
  issuedAt         DateTime       @default(now())
  issuedByUserId   String
  issuedByName     String
  approvedAt       DateTime?
  approvedByUserId String?
  approvedByName   String?
  sentAt           DateTime?
  sentToEmail      String?
  objectKeyPdf     String?
  status           String         @default("RECIBO_PENDIENTE_VERIFICACION")
  createdAt        DateTime       @default(now())
  tenantId         String
  contract         Contract       @relation(fields: [contractId], references: [id])
  invoice          BillingInvoice @relation(fields: [invoiceId], references: [id])
  payment          BillingPayment @relation(fields: [paymentId], references: [id])
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([contractId])
  @@index([status])
  @@index([issuedAt])
  @@index([tenantId])
}

model BillingCreditNote {
  id                 String         @id @default(cuid())
  creditNoteNumber   String         @unique
  contractId         String
  invoiceId          String
  contractNumber     String
  reason             String
  amount             Decimal        @db.Decimal(14, 2)
  status             String         @default("NC_EMITIDA")
  sourceDocumentType String
  sourceDocumentId   String
  issuedAt           DateTime       @default(now())
  issuedByUserId     String
  issuedByName       String
  appliedAt          DateTime?
  appliedByUserId    String?
  appliedByName      String?
  objectKeyPdf       String?
  createdAt          DateTime       @default(now())
  tenantId           String
  contract           Contract       @relation(fields: [contractId], references: [id])
  invoice            BillingInvoice @relation(fields: [invoiceId], references: [id])
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([contractId])
  @@index([status])
  @@index([issuedAt])
  @@index([tenantId])
}

model BillingClientBalance {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  availableCreditAmount Decimal  @db.Decimal(14, 2)
  currency              String   @default("CRC")
  updatedAt             DateTime @updatedAt
  tenantId              String
  client                Client   @relation(fields: [clientId], references: [id])
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model BillingAuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  actorUserId String
  actorName   String
  beforeJson  Json?
  afterJson   Json?
  sourceIp    String?
  userAgent   String?
  createdAt   DateTime @default(now())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([tenantId])
}

model ExchangeRate {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  buyRate     Decimal  @db.Decimal(10, 4)
  sellRate    Decimal  @db.Decimal(10, 4)
  source      String   @default("MANUAL")
  setByUserId String
  setByName   String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([date, tenantId])
  @@index([date])
  @@index([setByUserId])
  @@index([tenantId])
}

model CompanyBankAccount {
  id                String           @id @default(cuid())
  bankName          String
  accountNumber     String           @unique
  accountType       String
  currency          String
  sinpeNumber       String?
  accountHolderName String
  isActive          Boolean          @default(true)
  notes             String?
  createdByUserId   String
  createdByName     String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  companyName       String           @default("Empresa")
  tenantId          String
  payments          BillingPayment[]
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([bankName])
  @@index([currency])
  @@index([isActive])
  @@index([companyName])
  @@index([createdAt])
  @@index([tenantId])
}

model PaymentReceiptImage {
  id                          String          @id @default(cuid())
  paymentId                   String?         @unique
  objectKey                   String          @unique
  originalFileName            String
  mimeType                    String
  size                        Int
  extractedData               Json
  extractedAmount             Decimal?        @db.Decimal(14, 2)
  extractedCurrency           String?
  extractedDate               DateTime?
  extractedReference          String?
  extractedOriginBank         String?
  extractedDestinationBank    String?
  extractedDestinationAccount String?
  extractedPayerName          String?
  extractedPaymentCode        String?
  extractedNotes              String?
  confidenceScore             Decimal?        @db.Decimal(5, 4)
  processingStatus            String          @default("PENDING")
  processingError             String?
  processedAt                 DateTime?
  uploadedByUserId            String
  uploadedByName              String
  createdAt                   DateTime        @default(now())
  payment                     BillingPayment? @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([processingStatus])
  @@index([createdAt])
}

model TravelPackage {
  id              String     @id @default(cuid())
  name            String
  destination     String
  departureDate   DateTime
  returnDate      DateTime
  capacity        Int
  occupiedSlots   Int        @default(0)
  status          String     @default("OPEN")
  packagePrice    Decimal?   @db.Decimal(14, 2)
  priceCurrency   String     @default("USD")
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  packageCode     String     @unique
  tenantId        String
  minReservation  Decimal?   @db.Decimal(14, 2)
  contracts       Contract[]
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([departureDate])
  @@index([status])
  @@index([createdAt])
  @@index([packageCode])
  @@index([tenantId])
}

model Employee {
  id              String             @id @default(cuid())
  tenantId        String
  fullName        String
  documentId      String
  dateOfBirth     DateTime?
  email           String
  phone           String?
  address         String?
  hireDate        DateTime
  position        String
  department      String?
  monthlySalary   Decimal            @db.Decimal(12, 2)
  dailySalary     Decimal            @db.Decimal(12, 2)
  status          EmployeeStatus     @default(ACTIVO)
  terminationDate DateTime?
  userId          String?            @unique
  createdByUserId String
  createdByName   String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  documents       EmployeeDocument[]
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?              @relation(fields: [userId], references: [id])

  @@unique([tenantId, documentId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@index([position])
  @@index([department])
  @@index([userId])
  @@map("employees")
}

model EmployeeDocument {
  id               String               @id @default(cuid())
  employeeId       String
  tenantId         String
  documentType     EmployeeDocumentType
  fileName         String
  fileUrl          String
  objectKey        String               @unique
  mimeType         String
  size             Int
  notes            String?
  uploadedByUserId String
  uploadedByName   String
  uploadedAt       DateTime             @default(now())
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tenantId])
  @@index([documentType])
  @@index([uploadedAt])
  @@map("employee_documents")
}

model InternalTrip {
  id              String                @id @default(cuid())
  tripCode        String                @unique
  name            String
  destination     String
  description     String?
  departureDate   DateTime
  returnDate      DateTime
  departureTime   String?
  returnTime      String?
  capacity        Int
  occupiedSlots   Int                   @default(0)
  price           Decimal               @db.Decimal(12, 2)
  currency        String
  minReservation  Decimal?              @db.Decimal(12, 2)
  transportType   TransportType
  itinerary       String
  status          String                @default("OPEN")
  createdByUserId String
  createdByName   String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenantId        String
  contracts       Contract[]
  bookings        InternalTourBooking[]
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([departureDate])
  @@index([tenantId])
  @@index([status])
  @@index([tripCode])
  @@map("internal_trips")
}

model InternalTourBooking {
  id               String               @id @default(cuid())
  bookingCode      String               @unique
  internalTripId   String
  clientId         String
  participantCount Int
  totalAmount      Decimal              @db.Decimal(12, 2)
  currency         String               @default("CRC")
  paidAmount       Decimal              @default(0) @db.Decimal(12, 2)
  pendingAmount    Decimal              @db.Decimal(12, 2)
  status           String               @default("PENDING")
  notes            String?
  createdByUserId  String
  createdByName    String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenantId         String
  payments         BillingPayment[]
  client           Client               @relation(fields: [clientId], references: [id])
  internalTrip     InternalTrip         @relation(fields: [internalTripId], references: [id])
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice          InternalTourInvoice?

  @@unique([internalTripId, clientId, tenantId])
  @@index([internalTripId])
  @@index([clientId])
  @@index([tenantId])
  @@index([status])
  @@map("internal_tour_bookings")
}

model InternalTourInvoice {
  id             String              @id @default(cuid())
  bookingId      String              @unique
  invoiceNumber  String              @unique
  totalAmount    Decimal             @db.Decimal(12, 2)
  paidAmount     Decimal             @default(0) @db.Decimal(12, 2)
  pendingAmount  Decimal             @db.Decimal(12, 2)
  issuedAt       DateTime            @default(now())
  paymentDueDate DateTime?
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenantId       String
  booking        InternalTourBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([tenantId])
  @@index([invoiceNumber])
  @@map("internal_tour_invoices")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AttendanceConfig {
  id                           String   @id @default(cuid())
  tenantId                     String   @unique
  requireAttendanceForAgente   Boolean  @default(true)
  requireAttendanceForOperador Boolean  @default(true)
  requireAttendanceForVendedor Boolean  @default(true)
  requireAttendanceForAdmin    Boolean  @default(false)
  requireAttendanceForContador Boolean  @default(false)
  break1Duration               Int      @default(15)
  lunchDuration                Int      @default(60)
  break2Duration               Int      @default(15)
  break3Duration               Int      @default(15)
  regularHours                 Int      @default(8)
  maxOtHours                   Int      @default(4)
  systemHours                  Json     @default("{\"timezone\": \"America/Costa_Rica\", \"systemEnd\": \"20:00\", \"systemStart\": \"08:00\"}")
  otEnabled                    Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  tenants                      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("attendance_config")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AttendanceCorrection {
  id                 String          @id @default(cuid())
  correctedByUserId  String
  tenantId           String
  entryId            String
  reason             String
  beforeType         String
  beforeClockIn      DateTime
  beforeClockOut     DateTime?
  beforeDuration     Int?
  afterType          String
  afterClockIn       DateTime
  afterClockOut      DateTime?
  afterDuration      Int?
  createdAt          DateTime        @default(now())
  User               User            @relation(fields: [correctedByUserId], references: [id], onDelete: Cascade)
  attendance_entries AttendanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tenants            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([correctedByUserId])
  @@index([entryId])
  @@index([tenantId])
  @@map("attendance_corrections")
}

