# ============================================================================
# BARMENTECH SAAS - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# 
# COPY this file to .env.local (for local development) or .env (for defaults)
# NEVER commit .env or .env.local to git (they contain sensitive data)
# This .env.example file should be kept updated and versionized
#
# ============================================================================

# APPLICATION
PORT=3001
NODE_ENV=development
APP_ENV=dev

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h

# DATABASE - PostgreSQL
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# SEED (Initial admin user for development)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator

# EMAIL CONFIGURATION
# From addresses for different email types
CONTRACTS_FROM_EMAIL=contracts@example.com
AUTH_FROM_EMAIL=auth@example.com
RESEND_FROM_EMAIL=noreply@example.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# DIGITALOCEAN SPACES (S3-compatible object storage)
# For document storage, assets, contracts, etc.
DO_SPACES_REGION=sfo3
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_KEY=DO_ACCESS_KEY_HERE
DO_SPACES_SECRET=DO_SECRET_KEY_HERE

# RATE LIMITING
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# PUPPETEER (for PDF generation)
# Set to true if running in container without display
PUPPETEER_DISABLE_SANDBOX=false
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# ============================================================================
# NOTES:
# - .env.local takes priority over .env
# - For local development: use .env.local with development credentials
# - For production: set environment variables directly in hosting platform
# - Never hardcode secrets in code or commit sensitive .env files
# ============================================================================
